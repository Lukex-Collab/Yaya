/* pages/home/home.wxss — 牙牙主页样式 */
.home-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #FDF0F3 40%, #FFF8F0 100%);
}

/* ── 导航栏 ── */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  padding-bottom: 16rpx;
}
.nav-greeting {
  font-size: 28rpx;
  color: #9B8B8B;
  display: block;
}
.nav-nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: #5C3D2E;
  display: block;
  margin-top: 4rpx;
}
.nav-right {
  margin-top: 8rpx;
}
.safety-shield {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.8);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.shield-icon { font-size: 40rpx; }
.shield-dot {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.shield-dot.safe { background: #7BC67E; }
.shield-dot.alert { background: #FF4D4F; animation: blink 0.5s infinite; }
.shield-dot.offline { background: #9B8B8B; }
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ── 牙牙舞台 ── */
.yaya-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  position: relative;
}
.yaya-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.5s ease;
}
.yaya-avatar:active {
  transform: scale(0.95);
}
.yaya-canvas {
  width: 360rpx;
  height: 360rpx;
}
.yaya-emoji {
  width: 320rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, #F7B8C4 0%, #F4A0B5 60%, #D4A8D6 100%);
  border-radius: 50%;
  box-shadow:
    0 16rpx 48rpx rgba(244, 160, 181, 0.3),
    inset 0 -8rpx 24rpx rgba(0,0,0,0.05);
  animation: float 3s ease-in-out infinite;
}
.yaya-face {
  font-size: 140rpx;
  animation: breathe 4s ease-in-out infinite;
}
.yaya-status-bubble {
  margin-top: 24rpx;
  padding: 16rpx 32rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(244, 160, 181, 0.15);
  font-size: 28rpx;
  color: #5C3D2E;
  max-width: 500rpx;
  text-align: center;
  position: relative;
}
.yaya-status-bubble::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid white;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* 状态变体 */
.yaya-emoji.sleepy { opacity: 0.8; }
.yaya-emoji.worried {
  background: radial-gradient(circle, #D4A8D6 0%, #B8A0D0 60%, #9B8B8B 100%);
}
.yaya-emoji.excited {
  animation: bounce 0.6s ease-in-out infinite;
}
@keyframes bounce {
  0%, 100% { transform: scale(1) translateY(0); }
  30% { transform: scale(1.1) translateY(-30rpx); }
  50% { transform: scale(0.95) translateY(0); }
  70% { transform: scale(1.05) translateY(-15rpx); }
}

/* ── 信息卡片行 ── */
.yaya-info-row {
  display: flex;
  padding: 0 32rpx;
  gap: 24rpx;
  margin-top: 24rpx;
}
.info-card {
  flex: 1;
  padding: 24rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.blackboard {
  background: linear-gradient(135deg, #4A6741 0%, #5C3D2E 100%);
  color: white;
  position: relative;
  overflow: hidden;
}
.blackboard::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    0deg, transparent, transparent 2rpx, rgba(255,255,255,0.03) 2rpx, rgba(255,255,255,0.03) 4rpx
  );
  border-radius: 24rpx;
}
.blackboard-icon {
  font-size: 36rpx;
}
.blackboard-date {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}
.blackboard-fact {
  display: block;
  font-size: 22rpx;
  margin-top: 8rpx;
  line-height: 1.5;
  opacity: 0.9;
}
.care-bubble {
  background: linear-gradient(135deg, #FFF8F0, #FDF0F3);
}
.care-icon {
  font-size: 36rpx;
}
.care-text {
  display: block;
  font-size: 26rpx;
  color: #5C3D2E;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ── 语音按钮 ── */
.voice-btn-area {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0 64rpx;
}
.voice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #F4A0B5, #FF8FA3);
  border-radius: 50%;
  box-shadow: 0 12rpx 40rpx rgba(255, 143, 163, 0.35);
  transition: all 0.2s ease;
}
.voice-btn:active {
  transform: scale(0.92);
}
.voice-btn.recording {
  background: linear-gradient(135deg, #FF8FA3, #FF6B81);
  box-shadow: 0 0 0 12rpx rgba(255, 143, 163, 0.15),
              0 0 0 32rpx rgba(255, 143, 163, 0.08);
  animation: pulse 1s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 12rpx rgba(255, 143, 163, 0.15), 0 0 0 32rpx rgba(255, 143, 163, 0.08); }
  50% { box-shadow: 0 0 0 24rpx rgba(255, 143, 163, 0.2), 0 0 0 48rpx rgba(255, 143, 163, 0.12); }
}
.voice-icon {
  font-size: 60rpx;
}
.voice-label {
  font-size: 22rpx;
  color: white;
  margin-top: 8rpx;
}

/* ── 提示 ── */
.yaya-hint {
  text-align: center;
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}
.yaya-hint text {
  font-size: 24rpx;
  color: #9B8B8B;
}
