/* 灵伴世界 — 3D探索世界样式 */
.world-container { min-height:100vh; background: linear-gradient(180deg,#E8F5E9,#C8E6C9 30%,#BBDEFB 60%,#FFF8F0 100%); }

.world-nav { display:flex; justify-content:space-between; align-items:flex-start; padding:24rpx 28rpx 12rpx; }
.nav-title { font-size:40rpx; font-weight:700; color:#2E5C3D; text-shadow:0 2rpx 8rpx rgba(255,255,255,0.5); display:block; }
.nav-subtitle { font-size:24rpx; color:#5C8D6E; display:block; margin-top:4rpx; }
.currency-display { display:flex; align-items:center; gap:8rpx; padding:12rpx 20rpx; background:rgba(255,255,255,0.85); border-radius:32rpx; backdrop-filter:blur(12rpx); }
.currency-icon { font-size:28rpx; }
.currency-value { font-size:28rpx; font-weight:600; color:#FF8F00; }

/* 3D世界舞台 */
.world-stage { position:relative; height:520rpx; margin:16rpx 24rpx; border-radius:32rpx; overflow:hidden; background:linear-gradient(180deg,#87CEEB 0%,#E0F7FA 40%,#A5D6A7 70%,#81C784 100%); box-shadow:0 8rpx 40rpx rgba(0,0,0,0.08); }
.world-canvas { width:100%; height:100%; }
.pet-on-stage { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); display:flex; flex-direction:column; align-items:center; animation: petBounce 2s ease-in-out infinite; }
.pet-on-stage.idle { animation-duration:3s; }
.pet-on-stage.playing { animation-duration:0.6s; }
.pet-emoji { font-size:100rpx; transition:transform 0.3s; }
.pet-on-stage.playing .pet-emoji { transform:scale(1.2) rotate(10deg); }
.pet-name-tag { margin-top:8rpx; padding:6rpx 20rpx; background:rgba(255,255,255,0.9); border-radius:20rpx; font-size:22rpx; color:#5C3D2E; font-weight:600; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.06); }
@keyframes petBounce { 0%,100%{transform:translate(-50%,-50%) translateY(0)} 50%{transform:translate(-50%,-50%) translateY(-12rpx)} }

/* 探索点标记 */
.explore-marker { position:absolute; transform:translate(-50%,-50%); }
.marker { display:flex; flex-direction:column; align-items:center; animation:markerFloat 2s ease-in-out infinite; }
.marker:nth-child(2) { animation-delay:0.5s; }
.marker:nth-child(3) { animation-delay:1s; }
.marker:nth-child(4) { animation-delay:1.5s; }
.marker:nth-child(5) { animation-delay:0.8s; }
.marker-icon { font-size:40rpx; }
.marker-label { font-size:20rpx; color:white; background:rgba(0,0,0,0.5); padding:4rpx 12rpx; border-radius:12rpx; margin-top:4rpx; white-space:nowrap; }
@keyframes markerFloat { 0%,100%{transform:translate(-50%,-50%) translateY(0)} 50%{transform:translate(-50%,-50%) translateY(-8rpx)} }

/* 底部操作栏 */
.world-actions { display:flex; justify-content:space-around; padding:16rpx 24rpx; margin:16rpx 24rpx; background:rgba(255,255,255,0.85); border-radius:32rpx; backdrop-filter:blur(12rpx); box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04); }
.action-btn { display:flex; flex-direction:column; align-items:center; gap:4rpx; padding:12rpx 16rpx; border-radius:20rpx; transition:all 0.2s; }
.action-btn:active { background:rgba(244,160,181,0.15); transform:scale(0.95); }
.action-btn.primary { background:linear-gradient(135deg,#F4A0B5,#FF8FA3); border-radius:28rpx; padding:16rpx 24rpx; }
.action-btn.primary .action-label { color:white; }
.action-icon { font-size:36rpx; }
.action-label { font-size:20rpx; color:#5C3D2E; }

/* 探索区域信息 */
.zone-info { margin:16rpx 24rpx; padding:28rpx; background:rgba(255,255,255,0.9); border-radius:24rpx; }
.zone-name { font-size:32rpx; font-weight:600; color:#2E5C3D; display:block; }
.zone-desc { font-size:26rpx; color:#5C3D2E; margin-top:8rpx; line-height:1.6; display:block; }
.zone-pets { margin-top:16rpx; display:flex; gap:8rpx; flex-wrap:wrap; }
.nearby-pet { font-size:40rpx; padding:8rpx 16rpx; background:rgba(244,160,181,0.1); border-radius:20rpx; }
