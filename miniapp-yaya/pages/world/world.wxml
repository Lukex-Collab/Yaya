<!-- 灵伴世界 — 3D等距探索世界 -->
<view class="world-container">
  <view class="world-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left">
      <text class="nav-title">灵伴世界</text>
      <text class="nav-subtitle">{{exploreStatus}}</text>
    </view>
    <view class="currency-display">
      <text class="currency-icon">💎</text>
      <text class="currency-value">{{gems}}</text>
    </view>
  </view>

  <!-- 3D等距世界地图 -->
  <view class="iso-world scrollable">
    <view class="iso-grid">
      <!-- 5x5 等距地块 -->
      <block wx:for="{{25}}" wx:key="*this" wx:for-index="i">
        <view class="iso-tile tile-{{tileTypes[i]}} {{tileStates[i]}}"
              style="--tile-x: {{i%5}}; --tile-y: {{i-i%5}}/5"
              bindtap="onTileTap" data-index="{{i}}">
          <text class="tile-icon">{{tileIcons[i]}}</text>
        </view>
      </block>
    </view>

    <!-- 浮动的灵伴 -->
    <view class="pet-on-grid {{petState}}" style="--pet-x: {{petPos.x}}; --pet-y: {{petPos.y}}">
      <text class="pet-emoji-3d">{{petEmoji}}</text>
      <view class="pet-name-tag">{{petName}} Lv.{{petLevel}}</view>
    </view>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar">
    <view class="action-btn" bindtap="goExplore"><text class="action-icon">🗺️</text><text class="action-label">探索</text></view>
    <view class="action-btn" bindtap="goPetDetail"><text class="action-icon">🐾</text><text class="action-label">宠物</text></view>
    <view class="action-btn primary" bindtap="goFeed"><text class="action-icon">🍖</text><text class="action-label">喂食</text></view>
    <view class="action-btn" bindtap="goShop"><text class="action-icon">🎁</text><text class="action-label">商店</text></view>
    <view class="action-btn" bindtap="goSocial"><text class="action-icon">👥</text><text class="action-label">社交</text></view>
  </view>

  <!-- 物种选择 -->
  <view class="species-bar">
    <view class="species-chip {{petSpecies=='云狐'?'active':''}}" bindtap="switchSpecies" data-species="云狐">🦊 云狐</view>
    <view class="species-chip {{petSpecies=='墨猫'?'active':''}}" bindtap="switchSpecies" data-species="墨猫">🐱 墨猫</view>
    <view class="species-chip {{petSpecies=='芽龙'?'active':''}}" bindtap="switchSpecies" data-species="芽龙">🐲 芽龙</view>
    <view class="species-chip {{petSpecies=='泡兔'?'active':''}}" bindtap="switchSpecies" data-species="泡兔">🐰 泡兔</view>
    <view class="species-chip {{petSpecies=='岩熊'?'active':''}}" bindtap="switchSpecies" data-species="岩熊">🐻 岩熊</view>
  </view>
</view>
