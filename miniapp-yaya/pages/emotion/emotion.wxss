.emotion-container { min-height:100vh; background:#FFF8F0; padding:24rpx; }
.emotion-section { margin-bottom:24rpx; }
.section-title { font-size:30rpx; font-weight:600; color:#5C3D2E; display:block; margin-bottom:20rpx; }
.emotion-chart { display:flex; justify-content:space-around; align-items:flex-end; height:200rpx; padding-top:24rpx; }
.chart-bar { display:flex; flex-direction:column; align-items:center; gap:8rpx; }
.chart-emoji { font-size:28rpx; }
.chart-fill { width:40rpx; background:linear-gradient(180deg,#F4A0B5,#D4A8D6); border-radius:20rpx 20rpx 0 0; }
.chart-label { font-size:22rpx; color:#9B8B8B; }
.insight-item { padding:16rpx 0; border-bottom:1rpx solid rgba(0,0,0,0.04); font-size:26rpx; color:#5C3D2E; line-height:1.6; }
.rescue-grid { display:flex; flex-wrap:wrap; gap:16rpx; }
.rescue-card { width:calc(50% - 8rpx); text-align:center; padding:28rpx 16rpx; background:#FFF8F0; border-radius:20rpx; }
.rescue-card:active { background:#FDF0F3; }
.rescue-emoji { font-size:48rpx; display:block; margin-bottom:8rpx; }
.rescue-label { font-size:24rpx; color:#5C3D2E; }
