/* pages/chat/chat.wxss — 对话页样式 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFF8F0;
}

/* ── 消息列表 ── */
.chat-messages {
  flex: 1;
  padding: 24rpx;
  padding-top: 16rpx;
}

/* 欢迎卡片 */
.welcome-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}
.welcome-emoji { font-size: 100rpx; margin-bottom: 24rpx; }
.welcome-title { font-size: 36rpx; font-weight: 600; color: #5C3D2E; }
.welcome-desc { font-size: 26rpx; color: #9B8B8B; margin-top: 12rpx; }

.quick-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 40rpx;
  padding: 0 32rpx;
}
.chip {
  padding: 16rpx 28rpx;
  background: white;
  border: 2rpx solid #F4A0B5;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: #F4A0B5;
  white-space: nowrap;
}
.chip:active {
  background: #F4A0B5;
  color: white;
}

/* 消息行 */
.message-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}
.msg-user { flex-direction: row-reverse; }
.msg-yaya { flex-direction: row; }

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50%;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.avatar-emoji { font-size: 36rpx; }

.msg-bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  margin: 0 16rpx;
  position: relative;
}
.bubble-user {
  background: linear-gradient(135deg, #F4A0B5, #F7B8C4);
  color: white;
  border-bottom-right-radius: 8rpx;
}
.bubble-yaya {
  background: white;
  color: #5C3D2E;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.msg-emotion {
  position: absolute;
  top: -16rpx;
  right: 8rpx;
  font-size: 24rpx;
}
.msg-text {
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.stream-cursor {
  animation: blink-cursor 0.8s infinite;
  color: #FF8FA3;
  font-weight: bold;
}
@keyframes blink-cursor {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 思考中 */
.thinking-indicator {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}
.thinking-avatar {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50%;
  font-size: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.thinking-bubble {
  padding: 20rpx 28rpx;
  background: white;
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  margin-left: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.typing-dots { display: flex; gap: 8rpx; }
.typing-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: #F4A0B5;
  border-radius: 50%;
  animation: dot-jump 0.8s infinite;
}
.typing-dots .dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes dot-jump {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-12rpx); opacity: 1; }
}

/* ── 输入区域 ── */
.input-area {
  background: white;
  border-top: 1rpx solid rgba(0,0,0,0.04);
  padding: 16rpx 24rpx;
}
.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.input-emoji-btn {
  font-size: 44rpx;
  padding: 8rpx;
}
.chat-input {
  flex: 1;
  background: #FFF8F0;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 30rpx;
  max-height: 160rpx;
  min-height: 72rpx;
  line-height: 1.5;
}
.send-btn {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #9B8B8B;
  background: #F5F5F5;
  white-space: nowrap;
}
.send-btn.active {
  background: linear-gradient(135deg, #F4A0B5, #FF8FA3);
  color: white;
}
.input-hint {
  text-align: center;
  padding: 8rpx 0;
  font-size: 22rpx;
  color: #D4A8D6;
}
