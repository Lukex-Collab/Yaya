.achievement-container { min-height:100vh; background:#FFF8F0; padding:24rpx; }
.growth-header { text-align:center; margin-bottom:24rpx; }
.growth-days { font-size:40rpx; font-weight:700; color:#5C3D2E; display:block; }
.growth-level { font-size:26rpx; color:#9B8B8B; margin-top:8rpx; display:block; }
.achievement-grid { display:flex; flex-wrap:wrap; gap:16rpx; }
.achievement-card { width:calc(50% - 8rpx); padding:24rpx; background:white; border-radius:20rpx; box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04); }
.achievement-card.unlocked { background:linear-gradient(135deg,#FFF8F0,#FDF0F3); border:2rpx solid #F4A0B5; }
.ach-emoji { font-size:44rpx; display:block; margin-bottom:8rpx; }
.ach-name { font-size:28rpx; font-weight:600; color:#5C3D2E; display:block; }
.ach-desc { font-size:22rpx; color:#9B8B8B; margin:4rpx 0 8rpx; display:block; }
.ach-progress { margin:8rpx 0; }
.ach-status { font-size:22rpx; color:#9B8B8B; display:block; margin-top:4rpx; }
