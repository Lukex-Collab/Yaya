.health-container { min-height:100vh; background:#FFF8F0; padding:24rpx; }
.section-card { margin-bottom:24rpx; }
.section-title { font-size:32rpx; font-weight:600; color:#5C3D2E; display:block; margin-bottom:20rpx; }
.period-summary { display:flex; justify-content:space-around; margin-bottom:24rpx; }
.period-stat { text-align:center; }
.ps-value { display:block; font-size:48rpx; font-weight:700; color:#F4A0B5; }
.ps-label { display:block; font-size:22rpx; color:#9B8B8B; margin-top:4rpx; }
.period-actions { display:flex; gap:16rpx; margin-bottom:24rpx; }
.mini-calendar { display:flex; flex-wrap:wrap; gap:8rpx; }
.cal-day { width:68rpx; height:68rpx; display:flex; align-items:center; justify-content:center; font-size:24rpx; border-radius:50%; }
.cal-day.period { background:#FFE0E6; color:#FF8FA3; font-weight:600; }
.cal-day.today { border:3rpx solid #F4A0B5; }
.check-item { display:flex; align-items:center; padding:12rpx 0; gap:16rpx; }
.check-box { font-size:36rpx; }
.check-label { font-size:28rpx; color:#5C3D2E; }
