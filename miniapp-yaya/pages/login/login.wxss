.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #F4A0B5 50%, #D4A8D6 100%);
  padding: 40px 30px;
}

.hero { text-align: center; margin-bottom: 40px; }

.yaya-icon { font-size: 80px; margin-bottom: 16px; }

.title {
  font-size: 36px;
  font-weight: bold;
  color: #5C3D2E;
  margin-bottom: 8px;
}

.subtitle {
  font-size: 16px;
  color: #9B8B8B;
}

.intro-text {
  font-size: 14px;
  color: #5C3D2E;
  text-align: center;
  line-height: 1.8;
  margin-bottom: 60px;
  opacity: 0.8;
}

.login-btn {
  width: 260px;
  height: 48px;
  border-radius: 24px;
  font-size: 16px;
  background: #5C3D2E !important;
}

.demo-note {
  margin-top: 20px;
  font-size: 12px;
  color: #9B8B8B;
}
