.safety-container { min-height:100vh; background:#FFF8F0; padding:24rpx; }
.safety-status-card { text-align:center; padding:48rpx 24rpx; border-radius:24rpx; margin-bottom:24rpx; }
.safety-status-card.safe { background:linear-gradient(135deg,#E8F5E9,#FFF8F0); }
.safety-status-card.alert { background:linear-gradient(135deg,#FFEBEE,#FFF8F0); animation:alert-pulse 2s infinite; }
@keyframes alert-pulse { 0%,100%{opacity:1} 50%{opacity:0.8} }
.safety-icon { font-size:72rpx; display:block; }
.safety-title { font-size:36rpx; font-weight:700; color:#5C3D2E; display:block; margin:16rpx 0 8rpx; }
.safety-desc { font-size:26rpx; color:#9B8B8B; }
.safety-section { margin-bottom:24rpx; }
.section-title { font-size:30rpx; font-weight:600; color:#5C3D2E; margin-bottom:16rpx; display:block; }
.door-item { display:flex; justify-content:space-between; align-items:center; padding:16rpx 0; border-bottom:1rpx solid rgba(0,0,0,0.04); font-size:28rpx; }
.mock-hint { font-size:20rpx; color:#D4A8D6; text-align:center; margin-top:16rpx; display:block; }
.log-item { padding:16rpx 0; border-bottom:1rpx solid rgba(0,0,0,0.04); display:flex; justify-content:space-between; }
.log-time { font-size:24rpx; color:#9B8B8B; }
.log-detail { font-size:26rpx; color:#5C3D2E; }
