{
  "envId": "yaya-d5gf9yfw20986839f",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "aiChat",
      "timeout": 30,
      "envVariables": {
        "DEEPSEEK_API_KEY": "{{DEEPSEEK_API_KEY}}"
      }
    },
    {
      "name": "memoryIngest",
      "timeout": 20,
      "envVariables": {
        "DEEPSEEK_API_KEY": "{{DEEPSEEK_API_KEY}}"
      }
    },
    {
      "name": "userLogin",
      "timeout": 10
    },
    {
      "name": "pushSchedule",
      "timeout": 30,
      "triggers": [
        {
          "name": "morningTrigger",
          "type": "timer",
          "config": "0 57 7 * * * *"
        },
        {
          "name": "nightTrigger",
          "type": "timer",
          "config": "0 3 22 * * * *"
        }
      ]
    }
  ]
}
