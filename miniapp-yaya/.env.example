# 牙牙（yaya）环境变量
# 在云开发控制台 → 设置 → 环境变量 中配置

# DeepSeek API Key (必填)
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 云开发环境 ID
# 在微信云开发控制台 → 设置 中获取
CLOUD_ENV_ID=yaya-env-id

# 微信 AppID
# 在 mp.weixin.qq.com → 开发 → 开发设置 中获取
WECHAT_APPID=wx_your_appid_here

# 微信 AppSecret (仅后端使用，不要暴露到小程序端)
WECHAT_APPSECRET=your_secret_here
